/* 扫码入口样式 */

page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.scan-content {
  text-align: center;
}

.scan-icon {
  margin-bottom: 40rpx;
}

.scan-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.scan-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 60rpx;
}

.scan-btn {
  margin-bottom: 40rpx;
}

.btn {
  display: block;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-default {
  background: #fff;
  color: #666;
  border: 1rpx solid #e5e5e5;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5e5;
}

.divider-text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}