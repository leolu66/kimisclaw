/* 二维码展示样式 - 全屏投影模式 */

page {
  background: #fff;
}

.qr-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #07c160 0%, #05a050 100%);
}

.qr-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

/* 任务信息 */
.task-info {
  text-align: center;
  margin-bottom: 60rpx;
}

.task-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.task-detail {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 10rpx;
}

.divider {
  margin: 0 20rpx;
}

.task-location {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 二维码区域 */
.qr-wrapper {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.qr-image {
  width: 500rpx;
  height: 500rpx;
  display: block;
}

.qr-placeholder {
  width: 500rpx;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

/* 提示文字 */
.qr-tips {
  text-align: center;
  margin-top: 60rpx;
}

.tip-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.tip-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.2);
}

.action-btn {
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: #fff;
  color: #07c160;
}

/* 全屏模式 */
.fullscreen {
  background: #000;
}

.fullscreen .qr-wrapper {
  transform: scale(1.2);
}