/* 调查编辑样式 */

page {
  background: #f5f5f5;
  padding-bottom: 300rpx;
}

.container {
  padding: 20rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #f5222d;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 题目区域 */
.questions-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 30rpx;
}

.empty-questions {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 0 20rpx 20rpx;
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-index {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.question-type {
  font-size: 24rpx;
  color: #07c160;
  background: #e6f7ed;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: auto;
}

.question-actions {
  display: flex;
  gap: 20rpx;
}

.action-delete {
  font-size: 26rpx;
  color: #f5222d;
}

.question-title-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

/* 选项列表 */
.options-list {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.option-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.option-delete {
  width: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: #f5222d;
}

.add-option {
  text-align: center;
  padding: 20rpx;
  color: #07c160;
  font-size: 28rpx;
}

/* 添加题目栏 */
.add-question-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 180rpx;
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
}

.add-btn {
  padding: 16rpx 30rpx;
  background: #e6f7ed;
  color: #07c160;
  border-radius: 32rpx;
  font-size: 28rpx;
}

/* 底部按钮 */
.btn-group {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-default {
  background: #f5f5f5;
  color: #666;
}