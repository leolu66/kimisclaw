/* 调查列表样式 */

page {
  background: #f5f5f5;
}

.container {
  height: 100vh;
}

.survey-list {
  padding: 20rpx;
}

.survey-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.survey-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.survey-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.question-count {
  font-size: 26rpx;
  color: #07c160;
  background: #e6f7ed;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.survey-preview {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.preview-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.more-questions {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding-top: 10rpx;
}

.survey-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.action-btn.edit {
  background: #e6f7ed;
  color: #07c160;
}

.action-btn.delete {
  background: #fff1f0;
  color: #f5222d;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}