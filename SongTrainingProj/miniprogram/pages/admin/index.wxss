/* 管理员首页样式 */

page {
  background: #f5f5f5;
}

.container {
  padding: 20rpx;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #07c160;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

/* 卡片标题 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.more-link {
  font-size: 26rpx;
  color: #07c160;
}

/* 快捷入口 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.action-icon.course { background: #e6f7ed; }
.action-icon.teacher { background: #fff2e8; }
.action-icon.unit { background: #e6f4ff; }
.action-icon.task { background: #f6ffed; }
.action-icon.survey { background: #f9f0ff; }
.action-icon.create { background: #fff7e6; }

.action-text {
  font-size: 26rpx;
  color: #666;
}

/* 近期培训 */
.recent-list {
  padding-top: 10rpx;
}

.empty-hint {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-date {
  width: 100rpx;
  text-align: center;
  margin-right: 20rpx;
}

.date-day {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #07c160;
  line-height: 1.2;
}

.date-month {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.recent-content {
  flex: 1;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.recent-info {
  display: flex;
  gap: 16rpx;
}

.info-tag {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.recent-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.recent-status.planned {
  background: #e6f7ed;
  color: #07c160;
}

.recent-status.ongoing {
  background: #fff2e8;
  color: #fa8c16;
}

.recent-status.completed {
  background: #f5f5f5;
  color: #999;
}

.recent-status.cancelled {
  background: #fff1f0;
  color: #f5222d;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}