/* 填写调查表样式 */

page {
  background: #f5f5f5;
}

.container {
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

.survey-form {
  margin-bottom: 30rpx;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.question-index {
  color: #07c160;
  margin-right: 10rpx;
}

.question-type {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.options-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.option-label radio,
.option-label checkbox {
  margin-right: 16rpx;
  transform: scale(0.9);
}

.text-answer {
  margin-top: 10rpx;
}

.text-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-group {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}