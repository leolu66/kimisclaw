/* 学员登录样式 */

page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 30rpx;
  color: #666;
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
}

.wechat-login-btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn .icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5e5;
}

.divider-text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 30rpx;
  background: #f8f8f8;
  border-radius: 48rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.footer {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 50rpx;
  font-size: 28rpx;
  color: #666;
}

.footer text {
  color: #07c160;
}

.divider-dot {
  margin: 0 20rpx;
  color: #ccc !important;
}