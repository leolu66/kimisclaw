/* 培训管理系统 - 全局样式 */

page {
  --primary-color: #07c160;
  --primary-hover: #06ad56;
  --danger-color: #fa5151;
  --warning-color: #ffc300;
  --text-color: #333;
  --text-secondary: #666;
  --text-light: #999;
  --border-color: #e5e5e5;
  --bg-color: #f5f5f5;
  --white: #fff;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  color: var(--text-color);
  background-color: var(--bg-color);
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.card {
  background: var(--white);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 15rpx;
  font-weight: 500;
  color: var(--text-color);
}

.form-label .required {
  color: var(--danger-color);
  margin-right: 8rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.form-input:focus,
.form-textarea:focus {
  border-color: var(--primary-color);
}

.form-textarea {
  min-height: 200rpx;
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn-primary {
  background: var(--primary-color);
  color: var(--white);
}

.btn-primary:active {
  background: var(--primary-hover);
}

.btn-danger {
  background: var(--danger-color);
  color: var(--white);
}

.btn-default {
  background: var(--white);
  color: var(--text-color);
  border: 1rpx solid var(--border-color);
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

/* 列表样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.list-item-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.list-item-actions {
  display: flex;
  gap: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.tag-primary {
  background: rgba(7, 193, 96, 0.1);
  color: var(--primary-color);
}

.tag-warning {
  background: rgba(255, 195, 0, 0.1);
  color: var(--warning-color);
}

.tag-danger {
  background: rgba(250, 81, 81, 0.1);
  color: var(--danger-color);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg-color);
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 26rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.4);
}

.fab:active {
  transform: scale(0.95);
}